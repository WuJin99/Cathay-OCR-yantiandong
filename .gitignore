# SVN 元数据
.svn/

# 编辑器 / IDE 本机状态
.vscode/
.agents/
.vs/
*.suo
*.user
*.vcxproj.user
~$*

# 现场问题资料，与工程编译无关
盐田东港场桥问题汇总/

# IARS：中间产物 / 发布物（源码在 IARS/IARS）
# obj = IntDir；x64 = OutDir；旧工程旁 x64 保留忽略以免残留
IARS/obj/
IARS/x64/
IARS/IARS/x64/

# 依赖压缩包。散文件留在本机，仓库只保留压缩包
# lib.zip 在 IARS/ 下，不在 lib/ 目录里
IARS/lib/*
IARS/include/*
!IARS/include/*.7z
!IARS/include/protomsg.7z
qr.zip

# GitHub 拒绝超过 100MB 的普通文件
盐田东港OCR/42台OCRIP地址.xlsx
